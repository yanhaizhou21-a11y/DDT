{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DDT",
  "version": "1.0.0",
  "identifier": "com.ddt.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ddt/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @ddt/web build",
    "frontendDist": "../packages/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daily Dashboard Tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
